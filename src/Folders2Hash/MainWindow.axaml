<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:input="clr-namespace:Avalonia.Input;assembly=Avalonia.Base"
                       xmlns:windowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                       x:Class="Folders2Hash.MainWindow"
                       Title="Folders2Hash"
                       Width="1240"
                       Height="700"
                       Icon="md5.ico">
    <Grid RowDefinitions="Auto,*"
          input:DragDrop.AllowDrop="True"
          input:DragDrop.Drop="GridOnDrop"
          input:DragDrop.DragOver="GridOnDragOver">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="Path" />
            <TextBox x:Name="InitialDirectory"
                     Width="540"
                     VerticalContentAlignment="Center"
                     LostFocus="InitialDirectoryOnLostFocus" />
            <Button x:Name="Browse" Width="90" Click="BrowseClick">Browse</Button>
            <Button x:Name="Generate" Width="90" Click="GenerateHashesOnClick">Generate</Button>
            <Button Width="40" Click="AboutWindowClick">...</Button>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,420" Margin="10,0,10,10">
            <DataGrid x:Name="ResultGrid"
                      Grid.Column="0"
                      Margin="0,0,20,0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding ShortFileName}" Width="3*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                    <DataGridTextColumn Header="HashSum" Binding="{Binding HashSum}" Width="4*" />
                    <DataGridTextColumn Header="Time Stamp" Binding="{Binding TimeStamp, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="SettingsPanel"
                    Grid.Column="1"
                    BorderBrush="{DynamicResource ThemeControlMidBrush}"
                    BorderThickness="1"
                    Padding="10"
                    IsVisible="True">
                <StackPanel Spacing="10">
                    <CheckBox x:Name="KeepFileExtension"
                              Content="Keep file extension (filename.ext.md5)"
                              IsCheckedChanged="FileExtension" />

                    <StackPanel>
                        <TextBlock Text="Hash algorithms" />
                        <TextBlock x:Name="HashAlgorithmsWatermark"
                                   Margin="0,2,0,6"
                                   FontSize="11"
                                   Opacity="0.8" />
                        <ListBox x:Name="HashAlgorithms" Height="280">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding ObjectData.DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsCheckedChanged="HashAlgorithmsOnCheckBoxChecked" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <Separator />

                    <StackPanel Spacing="5">
                        <TextBlock Text="Logging path" />
                        <TextBox x:Name="LoggingPath" LostFocus="LoggingPathOnLostFocus" />
                        <Button x:Name="BrowseLoggingPath"
                                HorizontalAlignment="Left"
                                Width="90"
                                Click="BrowseLoggingPathClick">
                            Browse
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</windowing:FAAppWindow>